APP_NAME=ESGChain
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=esgchain
DB_USERNAME=esgchain
DB_PASSWORD=esgchain_secret
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@esgchain.com
MAIL_FROM_NAME="${APP_NAME}"

# JWT RS256
JWT_PRIVATE_KEY=/app/keys/jwt-private.pem
JWT_PUBLIC_KEY=/app/keys/jwt-public.pem
JWT_ACCESS_TOKEN_TTL=3600
JWT_REFRESH_TOKEN_TTL=604800

# FastAPI AI 服務
AI_SERVICE_URL=http://esgchain-ai:8000
AI_SERVICE_TIMEOUT=120

# CORS
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
